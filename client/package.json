{
  "name": "spring-petclinic-reactjs",
  "version": "0.0.1",
  "description": "Spring Boot Pet Clinic Sample Application with React Frontend",
  "main": "index.js",
  "repository": "https://github.com/spring-petclinic/spring-petclinic-reactjs",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watchAll",
    "lint": "tslint --project tsconfig.json",
    "start": "webpack serve --config webpack.config.js",
    "build:clean": "webpack --config webpack.config.js",
    "build:prod": "webpack --config webpack.config.prod.js"
  },
  "author": "Nils Hartmann",
  "license": "ISC",
  "dependencies": {
    "bootstrap": "^3.4.1",
    "classnames": "^2.2.5",
    "moment": "^2.30.1",
    "react": "^15.7.0",
    "react-datepicker": "^0.29.0",
    "react-dom": "^15.7.0",
    "react-router": "^2.8.1"
  },
  "devDependencies": {
    "@types/classnames": "^2.3.4",
    "@types/enzyme": "^2.8.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.0",
    "@types/react": "^15.7.37",
    "@types/react-dom": "^15.5.22",
    "@types/react-router": "^2.0.61",
    "css-loader": "^6.10.0",
    "enzyme": "^2.9.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "less": "^4.2.0",
    "less-loader": "^12.2.0",
    "react-addons-test-utils": "^15.6.2",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "tslint": "^6.1.3",
    "typescript": "^5.6.3",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0",
    "whatwg-fetch": "^3.6.20"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "diagnostics": false
        }
      ]
    },
    "testRegex": "(/__tests__/.*\\.(test|spec))\\.(ts|tsx|js)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ]
  }
}
