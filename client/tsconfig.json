{
  "compilerOptions": {
    "jsx": "react",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": false,
    "noImplicitAny": false,
    "preserveConstEnums": true,
    "removeComments": true,
    "target": "ES2015",
    "lib": ["ES2015", "DOM"],
    "types": ["node", "jest"],
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src"]
}
